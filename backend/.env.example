# ==============================================================================
# PizzaHub Backend Environment Configuration Template
# Copy this file to '.env' and fill in your values before starting the server.
# NEVER commit your active '.env' file containing real secrets to version control.
# ==============================================================================

# Server Environment & Port
NODE_ENV=development
PORT=8000

# CORS Configuration: Comma-separated list of allowed frontend origins (or '*' for wildcard)
ALLOWED_ORIGINS=http://localhost:5173,http://localhost:3000

# MongoDB Database Connection String
# Local MongoDB:
DB_KEY=mongodb://localhost:27017/PizzaHub
# MongoDB Atlas (Production):
# DB_KEY=mongodb+srv://<db_username>:<db_password>@<cluster_name>.mongodb.net/PizzaHub?retryWrites=true&w=majority

# JWT Token Authentication
# Generate a strong 256-bit random string for production
JWT_SECRET_KEY=your_secure_random_jwt_secret_key_minimum_32_characters
JWT_PUBLIC_KEY=your_optional_jwt_public_key_or_identifier

# Razorpay Payment Gateway Credentials
# Retrieve from Razorpay Dashboard -> Settings -> API Keys (Test / Live Mode)
RPKEYID=rzp_test_your_razorpay_key_id
RPSECRETKEY=your_razorpay_secret_key

# Razorpay Webhook Configuration
# Register endpoint 'https://your-domain.com/api/checkout/webhook' in your Razorpay Dashboard.
# Set the secret entered in the webhook setup below (defaults to RPSECRETKEY if not specified):
RPWEBHOOKSECRET=your_razorpay_webhook_secret

# Nodemailer / Transactional SMTP Email Service
# For Gmail, generate an 'App Password' from Google Account Security settings.
MAIL_USERNAME=your_sender_email@gmail.com
MAIL_PASSWORD=your_email_app_password

# Site Metadata & Frontend URL
SITE_NAME=PizzaHub
SITE_EMAIL=support@pizzahub.com
SITE_PHONE=+919876543210
SITE_ADDRESS=123 Pizza Street, Food City
SITE_URL=http://localhost:5173
