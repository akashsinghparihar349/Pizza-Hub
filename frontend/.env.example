# ==============================================================================
# PizzaHub Frontend Environment Configuration Template
# Copy this file to '.env' and fill in your values before starting Vite.
# ==============================================================================

# Pizzeria Brand & Contact Info
VITE_APP_SITE_NAME=PizzaHub
VITE_APP_ADDRESS=123 Pizza Street, Food City
VITE_APP_EMAIL=orders@pizzahub.com
VITE_APP_PHONE=+919876543210
VITE_APP_WHATSAPP=+919876543210

# Map Links
VITE_APP_MAP1=https://maps.google.com
VITE_APP_MAP2=https://maps.google.com

# Social Links
VITE_APP_FACEBOOK=https://facebook.com
VITE_APP_TWITTER=https://twitter.com
VITE_APP_YOUTUBE=https://youtube.com
VITE_APP_LINKEDIN=https://linkedin.com
VITE_APP_INSTAGRAM=https://instagram.com

# Backend API & Media Servers
VITE_APP_BACKEND_SERVER=http://localhost:8000/api
VITE_APP_IMAGE_SERVER=http://localhost:8000/

# Optional Razorpay Key for Frontend Modal
# VITE_APP_RPKEYID=rzp_test_your_key_id
